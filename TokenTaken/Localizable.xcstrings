    "share.inscription.field.1" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watered the field with prompts; let's see what sprouted."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用提示词浇了遍地，看看长出了什么。"
          }
        }
      }
    },
    "share.inscription.field.2" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every token here was grown from scratch, no shortcuts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这片 Token 田是一行行亲手种出来的。"
          }
        }
      }
    },
    "share.inscription.field.3" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Good harvest this season. Still plenty of soil left."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这季收成不错，地里还有不少空位。"
          }
        }
      }
    },
    "share.inscription.field.4" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The agent plowed the rows; I mostly brought the seeds."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 负责翻土，我主要负责撒种子。"
          }
        }
      }
    },
    "share.inscription.field.5" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turned late-night bugs into bumper crops."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把深夜改过的 Bug，都攒成了这季收成。"
          }
        }
      }
    },
    "share.inscription.field.6" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache warmed the soil; output did the blooming."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缓存把地温热了，输出负责开花结果。"
          }
        }
      }
    },
    "share.inscription.field.7" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sowed half-baked ideas, reaped a tidy little farm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撒下去的是半成品点子，收回来的是一整片庄稼。"
          }
        }
      }
    },
    "share.inscription.field.8" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No rain check needed—tokens grow fine indoors."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用看天吃饭，屏幕前也能长出一片好庄稼。"
          }
        }
      }
    },
