    "Demo mode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示模式"
          }
        }
      }
    },
    "Demo mode shows synthetic data. Turn it off to read your own reports.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示模式展示的是合成数据。关闭后会读取你自己的报表。"
          }
        }
      }
    },
