      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "All time": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "累计"
          }
        }
      }
    },
    "Couldn't read the newest report. Showing the last saved copy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新报表读取失败，正在显示上次保存的副本。"
          }
        }
      }
    },
    "Couldn't read the report": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取报表"
          }
        }
      }
    },
    "Couldn't render the card.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成分享卡失败。"
          }
        }
      }
    },
    "Data is more than a day old": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据已超过一天未更新"
          }
        }
