    "Missing a Mac? It needs iCloud sync on and the same Apple ID as this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少了某台 Mac？它需要开启 iCloud 同步，并与这台 iPhone 登录同一个 Apple ID。"
          }
        }
      }
    },
    "Month": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月份"
