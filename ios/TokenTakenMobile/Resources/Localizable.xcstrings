          "stringUnit": {
            "state": "translated",
            "value": "Waiting for iCloud to finish downloading your report. Try again in a moment."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 iCloud 完成下载报表，请稍后重试。"
          }
        }
      }
    },
    "Waiting for the first report from your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 Mac 发来的第一份报表。"
          }
        }
      }
    },
    "iCloud is unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 不可用"
          }
        }
      }
    },
    "iCloud is unavailable. Showing the last saved copy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 不可用，正在显示上次保存的副本。"
          }
        }
      }
    },
    "rank.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rank is an estimate derived from public usage sources."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排名为估算，依据公开用量数据推算"
          }
        }
      }
    },
    "rank.line.top": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last 30 days · about top %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近 30 天 · 约前 %@"
          }
        }
      }
    },
    "rank.methodology": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranks compare your last 30 days of tokens with publicly reported usage from the Anthropic Claude Code cost documentation, Viberank and Tokscale. Every rank is an estimate for fun, not a ranking of anyone's work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排名把近 30 天的 Token 用量与 Anthropic Claude Code 成本文档、Viberank、Tokscale 的公开数据对比。所有排名都只是趣味估算，不代表任何人的工作水平。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
