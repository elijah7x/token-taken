      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有报表"
          }
        }
      }
    },
    "Open Token Taken on your Mac, go to Settings, and turn on Sync to iPhone. Your Mac and this iPhone must use the same Apple ID.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 版 Token Taken 的设置里打开「同步到 iPhone」。Mac 与这台 iPhone 需登录同一个 Apple ID。"
          }
        }
      }
    },
