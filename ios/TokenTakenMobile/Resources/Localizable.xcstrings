{
  "sourceLanguage": "en",
  "strings": {
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "All time": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "累计"
          }
        }
      }
    },
    "Couldn't read the newest report. Showing the last saved copy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最新报表读取失败，正在显示上次保存的副本。"
          }
        }
      }
    },
    "Couldn't read the report": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取报表"
          }
        }
      }
    },
    "Couldn't render the card.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成分享卡失败。"
          }
        }
      }
    },
    "Data is more than a day old": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据已超过一天未更新"
          }
        }
      }
    },
    "Data is more than a day old. Open Token Taken on your Mac to refresh.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data is more than a day old. Open Token Taken on your Mac to refresh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据已超过一天未更新，请在 Mac 上打开 Token Taken 刷新。"
          }
        }
      }
    },
    "Demo mode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示模式"
          }
        }
      }
    },
    "Demo mode shows synthetic data. Turn it off to read your own reports.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "演示模式展示的是合成数据。关闭后会读取你自己的报表。"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Downloading report": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading report"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在下载报表"
          }
        }
      }
    },
    "Downloading the newest report from iCloud. Showing the last saved copy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloading the newest report from iCloud. Showing the last saved copy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在从 iCloud 下载最新报表，当前显示上次保存的副本。"
          }
        }
      }
    },
    "Harnesses this month": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本月工具"
          }
        }
      }
    },
    "Last 12 months": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近 12 个月"
          }
        }
      }
    },
    "Last 30 days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近 30 天"
          }
        }
      }
    },
    "Macs in this report": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份报表包含的 Mac"
          }
        }
      }
    },
    "Missing a Mac? It needs iCloud sync on and the same Apple ID as this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少了某台 Mac？它需要开启 iCloud 同步，并与这台 iPhone 登录同一个 Apple ID。"
          }
        }
      }
    },
    "Month": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "月份"
          }
        }
      }
    },
    "No report yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有报表"
          }
        }
      }
    },
    "Open Token Taken on your Mac, go to Settings, and turn on Sync to iPhone. Your Mac and this iPhone must use the same Apple ID.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 版 Token Taken 的设置里打开「同步到 iPhone」。Mac 与这台 iPhone 需登录同一个 Apple ID。"
          }
        }
      }
    },
    "Partial": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分数据"
          }
        }
