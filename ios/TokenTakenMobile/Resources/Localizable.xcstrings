    "rank.footnote": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate based on the Anthropic Claude Code cost documentation, Viberank and Tokscale public leaderboards (2026-11)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "估算依据：Anthropic Claude Code 成本文档、Viberank 与 Tokscale 公开榜单（2026-11）"
          }
        }
      }
    },
    "rank.line.median": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About median or above · estimate among measured users"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约高于中位数 · 实测用户估算"
          }
        }
      }
    },
    "rank.line.top": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About top %@ · estimate among measured users"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约前 %@ · 实测用户估算"
          }
        }
      }
    },
    "rank.methodology": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranks compare your last 30 days of tokens with publicly reported usage from the Anthropic Claude Code cost documentation, Viberank and Tokscale. Every rank is an estimate for fun, not a ranking of anyone's work."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排名把近 30 天的 Token 用量与 Anthropic Claude Code 成本文档、Viberank、Tokscale 的公开数据对比。所有排名都只是趣味估算，不代表任何人的工作水平。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
