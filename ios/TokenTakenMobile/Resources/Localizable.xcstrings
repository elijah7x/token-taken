            "state": "translated",
            "value": "已同步"
          }
        }
      }
    },
    "The report file couldn't be decoded. Try again, or open Token Taken on your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报表文件无法解析。请重试，或在 Mac 版 Token Taken 里重新同步。"
          }
        }
      }
    },
    "The report in iCloud uses a newer format than this version of the app supports.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The report in iCloud uses a newer format than this version of the app supports."
